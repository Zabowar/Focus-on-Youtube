{
  "manifest_version": 3,
  "name": "Focus on YouTube",
  "author": "Pierre-Alexis Gatté",
  "version": "1.2.1",
  "description": "Améliore ta productivité sur YouTube en limitant les shorts et en retirant les miniatures, les vidéos et les commentaires.",
  "icons": {
    "32": "icon/icon32.png",
    "64": "icon/icon64.png",
    "128": "icon/icon128.png"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["*://www.youtube.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icon/icon32.png",
      "64": "icon/icon64.png",
      "128": "icon/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "focus-on-youtube@jekiffemanger.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
